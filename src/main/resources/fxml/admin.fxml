<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.okul.controller.AdminController"
      spacing="10" prefWidth="720" prefHeight="560">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="welcomeLabel" text="Yonetici Paneli" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cikis" onAction="#handleLogout"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Hesap Yonetimi">
            <VBox spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Yeni Hesap Olustur" style="-fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <TextField fx:id="firstNameField" promptText="Ad"/>
                    <TextField fx:id="lastNameField" promptText="Soyad"/>
                </HBox>
                <HBox spacing="8">
                    <TextField fx:id="accEmailField" promptText="E-posta"/>
                    <PasswordField fx:id="accPasswordField" promptText="Parola"/>
                    <ComboBox fx:id="roleCombo" promptText="Rol"/>
                </HBox>
                <Button text="Hesap Olustur" onAction="#handleCreateAccount"/>

                <Label text="Kayitli Kullanicilar (ogretmen + ogrenci)" style="-fx-font-weight: bold;"/>
                <ListView fx:id="usersList" prefHeight="240"/>
                <Button text="Secili Hesabi Sil" onAction="#handleDeleteAccount"/>
            </VBox>
        </Tab>

        <Tab text="Ders Yonetimi">
            <VBox spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Yeni Ders Ac" style="-fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <TextField fx:id="courseCodeField" promptText="Ders Kodu (orn BIL101)"/>
                    <TextField fx:id="courseNameField" promptText="Ders Adi"/>
                </HBox>
                <HBox spacing="8">
                    <ComboBox fx:id="teacherCombo" promptText="Ogretmen sec"/>
                    <TextField fx:id="quotaField" promptText="Kontenjan"/>
                    <TextField fx:id="creditField" promptText="Kredi"/>
                    <TextField fx:id="termField" promptText="Donem (orn 2025-Guz)"/>
                </HBox>
                <Button text="Ders Olustur" onAction="#handleCreateCourse"/>

                <Label text="Mevcut Dersler" style="-fx-font-weight: bold;"/>
                <ListView fx:id="coursesList" prefHeight="240"/>
                <Button text="Secili Dersi Sil" onAction="#handleDeleteCourse"/>
            </VBox>
        </Tab>

        <Tab text="Ogrenci Atama">
            <VBox spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Ogrenciyi Derse Ata (kayit)" style="-fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <ComboBox fx:id="assignCourseCombo" promptText="Ders sec"/>
                    <ComboBox fx:id="assignStudentCombo" promptText="Ogrenci sec"/>
                </HBox>
                <HBox spacing="8">
                    <Button text="Derse Ata" onAction="#handleAssign"/>
                    <Button text="Secili Dersin Kayitlilarini Goster" onAction="#handleShowEnrollments"/>
                </HBox>
                <Label text="Secili Dersin Ogrencileri" style="-fx-font-weight: bold;"/>
                <ListView fx:id="enrolledList" prefHeight="260"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
