<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.okul.controller.LoginController"
      alignment="CENTER" spacing="12" prefWidth="380" prefHeight="320">
    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <Label text="Okul Yonetim Sistemi" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Giris Yap" style="-fx-font-size: 14px;"/>

    <TextField fx:id="emailField" promptText="E-posta"/>
    <PasswordField fx:id="passwordField" promptText="Parola"/>

    <Button text="Giris" onAction="#handleLogin" defaultButton="true" prefWidth="200"/>

    <Label text="Ilk giris -> admin@okul.com / 1234"
           style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
</VBox>
